# Copy to .env.local and fill in. Required unless marked optional.
# .env.local is gitignored. If a key ever reaches a log or a chat window,
# rotate it in the portal rather than hoping.

# ---- Azure OpenAI ---------------------------------------------------------
# Resource, then Keys and Endpoint. Server only.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ---- Azure Document Intelligence -----------------------------------------
# Reads the PDF and keeps the page and position of every block. Server only.
AZURE_DOCUMENT_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_DOCUMENT_KEY=

# ---- OpenAlex -------------------------------------------------------------
# The email is required. OpenAlex asks for it and gives faster service in return.
# The key is optional and raises the daily budget tenfold, from about 1,000
# requests to about 10,000. Get one free at openalex.org/settings/api.
OPENALEX_CONTACT_EMAIL=you@example.com
OPENALEX_API_KEY=

# ---- Supabase, storage ----------------------------------------------------
# Optional. Without these, checking a paper still works end to end and the
# report appears as normal, with a warning that it was not saved. Only the
# watchlist and research projects need storage.
# Use the POOLED connection string on port 6543, not the direct one on 5432.
SUPABASE_URL=
DATABASE_URL=

# Optional. Nothing in the application reads this. It is the secret key for
# the Supabase Admin API, used from the command line to create accounts
# without going through the sign-up form. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Supabase, signing in -------------------------------------------------
# These two reach the browser, which is intended. The publishable key is safe
# there by design. Without them the landing page still works, but nobody can
# sign in and every dashboard page is unreachable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
